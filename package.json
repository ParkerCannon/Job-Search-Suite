  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.16.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
